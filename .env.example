# Local application
SESSION_SECRET=replace-with-a-long-random-value
# Mercado Pago does not accept localhost in Checkout Pro return URLs.
# Use your LAN IP for local tests or an HTTPS domain in production.
APP_URL=http://YOUR-LAN-IP:3001

# Mercado Pago — use TEST- credentials while validating the integration
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Required when APP_URL is a public HTTPS URL and webhooks are enabled
MERCADOPAGO_WEBHOOK_SECRET=

# Optional integrations
GEMINI_API_KEY=
GROQ_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Login verification emails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ClicLab <acesso@your-verified-domain.com>
